---
/**
 * Grilla de catálogo con buscador y filtros en el cliente.
 * Todos los productos se renderizan en el HTML (SEO) y el JS solo muestra/oculta y ordena.
 * Lee ?q= y ?cat= de la URL, y los mantiene sincronizados al filtrar.
 */
import Icon from '@/components/Icon.astro';
import ProductCard from '@/components/ProductCard.astro';
import type { Category, Product } from '@/lib/types';

interface Props {
  products: Product[];
  categories: Category[];
  counts: Record<string, number>;
  /** Categoría fija (página de categoría): oculta los chips de categoría. */
  lockedCategory?: string;
}
const { products, categories, counts, lockedCategory } = Astro.props;

const norm = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');
---

<div class="catalog" id="catalog" data-locked={lockedCategory ?? ''}>
  <div class="toolbar">
    <form class="search" role="search" onsubmit="return false">
      <Icon name="search" size={20} />
      <input id="cat-q" type="search" placeholder="Buscar por nombre, material, personaje…" autocomplete="off" aria-label="Buscar en el catálogo" />
      <button type="button" class="clear" id="cat-clear" aria-label="Limpiar búsqueda" hidden><Icon name="x-circle" size={18} /></button>
    </form>

    <div class="toolbar-right">
      <label class="check"><input type="checkbox" id="f-stock" /> <span>Solo disponibles</span></label>
      <label class="check"><input type="checkbox" id="f-custom" /> <span>Personalizables</span></label>
      <select class="input sort" id="cat-sort" aria-label="Ordenar">
        <option value="featured">Destacados primero</option>
        <option value="price-asc">Precio: menor a mayor</option>
        <option value="price-desc">Precio: mayor a menor</option>
        <option value="name">Nombre A–Z</option>
      </select>
    </div>
  </div>

  {
    !lockedCategory && (
      <div class="chips" role="group" aria-label="Filtrar por categoría">
        <button class="chip is-active" data-cat="">
          Todo <span class="count">{products.length}</span>
        </button>
        {categories.map((c) => (
          <button class="chip" data-cat={c.slug}>
            {c.name} <span class="count">{counts[c.slug] ?? 0}</span>
          </button>
        ))}
      </div>
    )
  }

  <p class="result-line" id="cat-result" aria-live="polite">
    Mostrando <b>{products.length}</b> productos
  </p>

  <div class="grid grid-4" id="cat-grid">
    {
      products.map((p) => (
        <div
          class="cat-item"
          data-slug={p.slug}
          data-search={norm([p.name, p.shortDescription, ...p.tags, ...p.categories].join(' '))}
          data-cats={p.categories.join(' ')}
          data-price={p.price}
          data-name={p.name}
          data-stock={p.inStock ? '1' : '0'}
          data-custom={p.customizable ? '1' : '0'}
          data-featured={p.featured ? '1' : '0'}
        >
          <ProductCard product={p} />
        </div>
      ))
    }
  </div>

  <div class="empty" id="cat-empty" hidden>
    <Icon name="box" size={48} stroke={1.4} />
    <h3>No encontramos productos con esa búsqueda</h3>
    <p>Prueba con otra palabra o <a href="/servicios#cotizar">cotiza una pieza personalizada</a>.</p>
    <button class="btn btn-outline" id="cat-reset">Limpiar filtros</button>
  </div>
</div>

<script>
  const root = document.getElementById('catalog')!;
  const q = document.getElementById('cat-q') as HTMLInputElement;
  const clear = document.getElementById('cat-clear') as HTMLButtonElement;
  const sort = document.getElementById('cat-sort') as HTMLSelectElement;
  const fStock = document.getElementById('f-stock') as HTMLInputElement;
  const fCustom = document.getElementById('f-custom') as HTMLInputElement;
  const grid = document.getElementById('cat-grid')!;
  const empty = document.getElementById('cat-empty')!;
  const result = document.getElementById('cat-result')!;
  const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.chip'));
  const items = Array.from(grid.querySelectorAll<HTMLElement>('.cat-item'));
  const locked = root.dataset.locked || '';

  const norm = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

  let cat = locked;

  function apply(push = true) {
    const terms = norm(q.value).split(/\s+/).filter(Boolean);
    clear.hidden = terms.length === 0;
    let visible = 0;

    for (const el of items) {
      const okQ = terms.every((t) => el.dataset.search!.includes(t));
      const okC = !cat || el.dataset.cats!.split(' ').includes(cat);
      const okS = !fStock.checked || el.dataset.stock === '1';
      const okP = !fCustom.checked || el.dataset.custom === '1';
      const show = okQ && okC && okS && okP;
      el.hidden = !show;
      if (show) visible++;
    }

    const sorted = [...items].sort((a, b) => {
      switch (sort.value) {
        case 'price-asc':
          return +a.dataset.price! - +b.dataset.price!;
        case 'price-desc':
          return +b.dataset.price! - +a.dataset.price!;
        case 'name':
          return a.dataset.name!.localeCompare(b.dataset.name!, 'es');
        default:
          return +b.dataset.featured! - +a.dataset.featured!;
      }
    });
    sorted.forEach((el) => grid.appendChild(el));

    empty.hidden = visible > 0;
    grid.hidden = visible === 0;
    result.innerHTML = `Mostrando <b>${visible}</b> ${visible === 1 ? 'producto' : 'productos'}${
      terms.length ? ` para “${q.value.trim()}”` : ''
    }`;

    if (push) {
      const url = new URL(location.href);
      q.value.trim() ? url.searchParams.set('q', q.value.trim()) : url.searchParams.delete('q');
      cat && !locked ? url.searchParams.set('cat', cat) : url.searchParams.delete('cat');
      history.replaceState(null, '', url);
    }
  }

  function setCat(slug: string) {
    cat = slug;
    chips.forEach((c) => c.classList.toggle('is-active', c.dataset.cat === slug));
    apply();
  }

  // Estado inicial desde la URL
  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? '';
  if (!locked && params.get('cat')) setCat(params.get('cat')!);

  q.addEventListener('input', () => apply());
  clear.addEventListener('click', () => {
    q.value = '';
    apply();
    q.focus();
  });
  sort.addEventListener('change', () => apply());
  fStock.addEventListener('change', () => apply());
  fCustom.addEventListener('change', () => apply());
  chips.forEach((c) => c.addEventListener('click', () => setCat(c.dataset.cat!)));
  document.getElementById('cat-reset')!.addEventListener('click', () => {
    q.value = '';
    fStock.checked = false;
    fCustom.checked = false;
    sort.value = 'featured';
    setCat(locked);
  });

  apply(false);
</script>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .search {
    flex: 1;
    min-width: 260px;
    max-width: 520px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 52px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--muted);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .search:focus-within {
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgba(21, 101, 216, 0.12);
  }
  .search input {
    flex: 1;
    border: 0;
    outline: none;
    background: none;
    color: var(--ink);
    font-size: 1rem;
    min-width: 0;
  }
  .search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .clear {
    color: var(--muted);
    display: grid;
  }
  .clear:hover {
    color: var(--ink);
  }
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }
  .check input {
    width: 18px;
    height: 18px;
    accent-color: var(--blue);
  }
  .sort {
    width: auto;
    padding-top: 11px;
    padding-bottom: 11px;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: var(--radius-pill);
  }
  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .result-line {
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 20px;
  }
  .result-line b {
    color: var(--ink);
  }
  .empty {
    text-align: center;
    padding: 64px 20px;
    color: var(--muted);
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
  }
  .empty svg {
    margin: 0 auto 12px;
    color: var(--muted-2);
  }
  .empty h3 {
    color: var(--ink);
  }
  .empty a {
    color: var(--blue);
    font-weight: 600;
  }
  .empty .btn {
    margin-top: 12px;
  }
  @media (max-width: 640px) {
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 6px;
      margin-left: calc(var(--gutter) * -1);
      margin-right: calc(var(--gutter) * -1);
      padding-left: var(--gutter);
      padding-right: var(--gutter);
      scrollbar-width: none;
    }
    .chips::-webkit-scrollbar {
      display: none;
    }
  }
</style>
