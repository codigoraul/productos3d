---
/**
 * Imagen del producto. Si no hay imagen, dibuja un placeholder con el color e icono
 * de la categoría principal (así el catálogo mock se ve bien hasta tener fotos).
 */
import Icon from '@/components/Icon.astro';
import { getCategory } from '@/lib/catalog';
import type { ProductImage } from '@/lib/types';

interface Props {
  images: ProductImage[];
  categorySlug: string;
  name: string;
  size?: 'card' | 'hero';
  loading?: 'lazy' | 'eager';
}
const { images, categorySlug, name, size = 'card', loading = 'lazy' } = Astro.props;
const cat = await getCategory(categorySlug);
const accent = cat?.accent ?? '#1565D8';
const icon = cat?.icon ?? 'cube';
const img = images[0];
---

{
  img ? (
    <img class:list={['pv-img', size]} src={img.src} alt={img.alt || name} loading={loading} decoding="async" />
  ) : (
    <div class:list={['pv-ph', size]} style={`--c:${accent}`} role="img" aria-label={name}>
      <span class="pv-glow" />
      <span class="pv-grid" />
      <span class="pv-icon">
        <Icon name={icon} size={size === 'hero' ? 96 : 56} stroke={1.5} />
      </span>
      <span class="pv-label">{cat?.name ?? 'Producto 3D'}</span>
    </div>
  )
}

<style>
  .pv-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pv-ph {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 20% 0%, color-mix(in srgb, var(--c) 30%, #fff) 0%, transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--c) 10%, #fff), color-mix(in srgb, var(--c) 22%, #fff));
    color: var(--c);
  }
  .pv-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--c) 14%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--c) 14%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 75%);
  }
  .pv-glow {
    position: absolute;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c) 28%, transparent);
    filter: blur(40px);
  }
  .pv-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 42%;
    aspect-ratio: 1;
    max-width: 150px;
    border-radius: 26%;
    background: #fff;
    box-shadow:
      0 20px 40px color-mix(in srgb, var(--c) 30%, transparent),
      inset 0 -6px 0 color-mix(in srgb, var(--c) 16%, #fff);
    transition: transform 0.4s var(--ease);
  }
  .pv-ph.hero .pv-icon {
    max-width: 220px;
  }
  :global(.card:hover) .pv-icon {
    transform: translateY(-6px) rotate(-4deg);
  }
  .pv-label {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
    opacity: 0.8;
  }
</style>
