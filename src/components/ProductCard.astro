---
import Icon from '@/components/Icon.astro';
import ProductVisual from '@/components/ProductVisual.astro';
import { formatCLP } from '@/lib/format';
import { getCategory } from '@/lib/catalog';
import type { Product } from '@/lib/types';
import { whatsappLink } from '@/config';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const cat = await getCategory(p.categories[0]);
const onSale = p.regularPrice && p.regularPrice > p.price;
const discount = onSale ? Math.round((1 - p.price / p.regularPrice!) * 100) : 0;
const wa = whatsappLink(`Hola, me interesa "${p.name}" (${formatCLP(p.price)}). ¿Está disponible?`);
---

<article class="card pc" data-id={p.id}>
  <a href={`/productos/${p.slug}`} class="pc-media" aria-label={p.name}>
    <ProductVisual images={p.images} categorySlug={p.categories[0]} name={p.name} />
    <div class="pc-badges">
      {onSale && <span class="badge badge-sale">-{discount}%</span>}
      {!p.inStock && <span class="badge badge-out">A pedido</span>}
      {p.customizable && <span class="badge badge-custom">Personalizable</span>}
    </div>
  </a>
  <div class="pc-body">
    {cat && <a href={`/categorias/${cat.slug}`} class="pc-cat">{cat.name}</a>}
    <h3 class="pc-title"><a href={`/productos/${p.slug}`}>{p.name}</a></h3>
    <p class="pc-desc">{p.shortDescription}</p>
    <div class="pc-foot">
      <div class="pc-price">
        {onSale && <s>{formatCLP(p.regularPrice!)}</s>}
        <strong>{formatCLP(p.price)}</strong>
      </div>
      <div class="pc-actions">
        <a href={`/productos/${p.slug}`} class="pc-btn" aria-label={`Ver ${p.name}`}><Icon name="eye" size={18} /></a>
        <a href={wa} target="_blank" rel="noopener" class="pc-btn wa" aria-label={`Pedir ${p.name} por WhatsApp`}
          ><Icon name="whatsapp" size={18} /></a
        >
      </div>
    </div>
  </div>
</article>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }
  .pc-media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .pc-media :global(img) {
    transition: transform 0.5s var(--ease);
  }
  .pc:hover .pc-media :global(img) {
    transform: scale(1.05);
  }
  .pc-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pc-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 18px 18px;
  }
  .pc-cat {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 6px;
  }
  .pc-title {
    font-size: 1.05rem;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .pc-title a:hover {
    color: var(--blue);
  }
  .pc-desc {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 14px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .pc-price {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .pc-price s {
    font-size: 0.78rem;
    color: var(--muted-2);
  }
  .pc-price strong {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--ink);
  }
  .pc-actions {
    display: flex;
    gap: 6px;
  }
  .pc-btn {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--bg-soft-2);
    color: var(--ink);
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .pc-btn:hover {
    background: var(--ink);
    color: #fff;
    transform: translateY(-2px);
  }
  .pc-btn.wa {
    background: #e7f9ee;
    color: #128c4a;
  }
  .pc-btn.wa:hover {
    background: var(--whatsapp);
    color: #fff;
  }
</style>
