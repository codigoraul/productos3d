---
/**
 * Slider principal: una slide por categoría con fondo fotográfico (public/slider/*.webp).
 * Autoplay, flechas, dots, swipe táctil, teclado y pausa al pasar el mouse. Sin librerías.
 */
import Icon from '@/components/Icon.astro';
import { getCategories, getCategoryCounts, getProductsByCategory } from '@/lib/catalog';
import { formatCLP } from '@/lib/format';

const categories = await getCategories();
const counts = await getCategoryCounts();

const slides = await Promise.all(
  categories.map(async (c) => {
    const prods = await getProductsByCategory(c.slug);
    const min = Math.min(...prods.map((p) => p.price));
    return { ...c, count: counts[c.slug] ?? 0, from: isFinite(min) ? min : 0 };
  })
);

const headlines: Record<string, string> = {
  llaveros: 'Llaveros que cuentan tu historia',
  'soportes-celular': 'Tu teléfono, siempre en su lugar',
  anime: 'Tus personajes, en 3D real',
  dibujos: 'De un dibujo a una pieza 3D',
  decoracion: 'Diseño impreso para tu espacio',
  personalizados: '¿Lo imaginas? Lo imprimimos',
};

/** Fondos fotográficos por categoría (1920×1080 WebP en public/slider/). */
const backgrounds: Record<string, string> = {
  llaveros: '/slider/llaveros-corporativo.webp',
  'soportes-celular': '/slider/soportes-celular.webp',
  anime: '/slider/anime.webp',
  dibujos: '/slider/dibujos.webp',
  decoracion: '/slider/decoracion.webp',
  personalizados: '/slider/personalizados.webp',
};
const fallbackBg = '/slider/personalizados.webp';
---

<section class="hero" id="hero" aria-roledescription="carrusel" aria-label="Categorías destacadas">
  <div class="hero-track" id="hero-track">
    {
      slides.map((s, i) => (
        <article
          class:list={['slide', { 'is-active': i === 0 }]}
          style={`--c:${s.accent}`}
          data-index={i}
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${slides.length}: ${s.name}`}
          aria-hidden={i !== 0 ? 'true' : 'false'}
        >
          <div class="slide-bg" aria-hidden="true">
            <img
              class="slide-img"
              src={backgrounds[s.slug] ?? fallbackBg}
              alt=""
              width="1920"
              height="1080"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
            />
            <div class="slide-shade" />
          </div>
          <div class="container slide-inner">
            <div class="slide-copy">
              <span class="slide-kicker">
                <Icon name={s.icon} size={16} /> {s.name} · {s.count} productos
              </span>
              <h2 class="slide-title">{headlines[s.slug] ?? s.name}</h2>
              <p class="slide-desc">{s.description}</p>
              <div class="slide-actions">
                <a href={`/categorias/${s.slug}`} class="btn btn-primary btn-lg">
                  Ver {s.name.toLowerCase()} <Icon name="arrow-right" />
                </a>
                <span class="slide-from">
                  desde <b>{formatCLP(s.from)}</b>
                </span>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="container hero-controls">
    <div class="hero-dots" role="tablist" aria-label="Elegir slide">
      {
        slides.map((s, i) => (
          <button
            class:list={['dot-btn', { 'is-active': i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={s.name}
            data-go={i}
          >
            <span class="dot-label">{s.name}</span>
            <span class="dot-bar">
              <span class="dot-fill" />
            </span>
          </button>
        ))
      }
    </div>
    <div class="hero-arrows">
      <button class="arrow" data-dir="-1" aria-label="Anterior"><Icon name="chevron-left" size={22} /></button>
      <button class="arrow" data-dir="1" aria-label="Siguiente"><Icon name="chevron-right" size={22} /></button>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('hero')!;
  const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
  const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot-btn'));
  const INTERVAL = 6000;
  let current = 0;
  let timer: number | undefined;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function go(next: number) {
    const n = (next + slides.length) % slides.length;
    if (n === current) return;
    slides[current].classList.remove('is-active');
    slides[current].setAttribute('aria-hidden', 'true');
    dots[current].classList.remove('is-active');
    dots[current].setAttribute('aria-selected', 'false');
    current = n;
    slides[current].classList.add('is-active');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.add('is-active');
    dots[current].setAttribute('aria-selected', 'true');
    restart();
  }

  function restart() {
    if (reduce) return;
    window.clearInterval(timer);
    root.style.setProperty('--interval', `${INTERVAL}ms`);
    // reinicia la animación de la barra de progreso
    dots.forEach((d) => {
      const f = d.querySelector<HTMLElement>('.dot-fill')!;
      f.style.animation = 'none';
      void f.offsetWidth;
      f.style.animation = '';
    });
    timer = window.setInterval(() => go(current + 1), INTERVAL);
  }

  root.querySelectorAll<HTMLButtonElement>('.arrow').forEach((b) =>
    b.addEventListener('click', () => go(current + Number(b.dataset.dir)))
  );
  dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.go))));

  root.addEventListener('mouseenter', () => window.clearInterval(timer));
  root.addEventListener('mouseleave', restart);
  root.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(current + 1);
    if (e.key === 'ArrowLeft') go(current - 1);
  });

  // Swipe
  let x0 = 0;
  root.addEventListener('pointerdown', (e) => (x0 = e.clientX), { passive: true });
  root.addEventListener(
    'pointerup',
    (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 50) go(current + (dx < 0 ? 1 : -1));
    },
    { passive: true }
  );

  restart();
</script>

<style>
  .hero {
    position: relative;
    background: #0b1220;
    color: #fff;
    overflow: hidden;
    --interval: 6000ms;
  }
  .hero-track {
    position: relative;
    min-height: 560px;
  }
  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.8s var(--ease),
      visibility 0.8s;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  /* Fondo fotográfico */
  .slide-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0b1220;
  }
  .slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    transform: scale(1.06);
    transition: transform 7s linear;
  }
  .slide.is-active .slide-img {
    transform: scale(1);
  }
  /* Sombra para legibilidad del texto (izquierda) + base para los controles */
  .slide-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 12, 24, 0.86) 0%, rgba(8, 12, 24, 0.62) 38%, rgba(8, 12, 24, 0.1) 68%, rgba(8, 12, 24, 0) 100%),
      linear-gradient(180deg, rgba(8, 12, 24, 0.25) 0%, rgba(8, 12, 24, 0) 30%, rgba(8, 12, 24, 0) 70%, rgba(8, 12, 24, 0.55) 100%);
  }

  .slide-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 40px;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .slide-copy > * {
    opacity: 0;
    transform: translateY(16px);
  }
  .slide.is-active .slide-copy > * {
    animation: rise 0.7s var(--ease) forwards;
  }
  .slide.is-active .slide-copy > :nth-child(2) {
    animation-delay: 0.08s;
  }
  .slide.is-active .slide-copy > :nth-child(3) {
    animation-delay: 0.16s;
  }
  .slide.is-active .slide-copy > :nth-child(4) {
    animation-delay: 0.24s;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .slide-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    margin-bottom: 20px;
  }
  .slide-kicker :global(svg) {
    color: color-mix(in srgb, var(--c) 55%, #fff);
  }
  .slide-title {
    max-width: 13ch;
    margin-bottom: 16px;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }
  .slide-desc {
    font-size: 1.12rem;
    color: rgba(255, 255, 255, 0.82);
    max-width: 46ch;
    margin-bottom: 28px;
  }
  .slide-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .slide-from {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
  }
  .slide-from b {
    color: #fff;
    font-size: 1.2rem;
    font-weight: 800;
  }

  /* Controles */
  .hero-controls {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 6px;
    padding-bottom: 22px;
  }
  .hero-dots {
    display: flex;
    gap: 6px;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .hero-dots::-webkit-scrollbar {
    display: none;
  }
  .dot-btn {
    flex: 1;
    min-width: 96px;
    padding: 10px 12px;
    border-radius: 12px;
    text-align: left;
    color: rgba(255, 255, 255, 0.55);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .dot-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .dot-btn.is-active {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .dot-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
    margin-bottom: 8px;
  }
  .dot-bar {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.18);
    overflow: hidden;
  }
  .dot-fill {
    display: block;
    height: 100%;
    width: 0;
    background: #fff;
  }
  .dot-btn.is-active .dot-fill {
    animation: fill var(--interval) linear forwards;
  }
  @keyframes fill {
    to {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot-btn.is-active .dot-fill {
      animation: none;
      width: 100%;
    }
    .slide-img,
    .slide.is-active .slide-img {
      transform: none;
      transition: none;
    }
  }
  .hero-arrows {
    display: flex;
    gap: 8px;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .arrow:hover {
    background: #fff;
    color: var(--ink);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .slide-inner {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-top: 56px;
      padding-bottom: 40px;
    }
    .hero-track {
      min-height: 480px;
    }
    .slide-img {
      object-position: 78% center;
    }
    .slide-shade {
      background:
        linear-gradient(90deg, rgba(8, 12, 24, 0.9) 0%, rgba(8, 12, 24, 0.7) 50%, rgba(8, 12, 24, 0.35) 100%),
        linear-gradient(180deg, rgba(8, 12, 24, 0.3) 0%, rgba(8, 12, 24, 0) 40%, rgba(8, 12, 24, 0.6) 100%);
    }
    .slide-title {
      max-width: none;
    }
    .dot-btn {
      min-width: 0;
      flex: none;
    }
  }
  @media (max-width: 640px) {
    .hero-track {
      min-height: 440px;
    }
    .slide-img {
      object-position: 62% center;
    }
    .slide-shade {
      background:
        linear-gradient(180deg, rgba(8, 12, 24, 0.55) 0%, rgba(8, 12, 24, 0.45) 45%, rgba(8, 12, 24, 0.85) 100%);
    }
    .dot-label {
      display: none;
    }
    .dot-btn {
      padding: 10px 8px;
      min-width: 36px;
    }
    .dot-bar {
      width: 100%;
    }
    .hero-arrows {
      display: none;
    }
  }
</style>
