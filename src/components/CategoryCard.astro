---
import Icon from '@/components/Icon.astro';
import type { Category } from '@/lib/types';
import { getCategoryImage } from '@/lib/catalog';

interface Props {
  category: Category;
  count?: number;
  variant?: 'tile' | 'wide';
}
const { category: c, count, variant = 'tile' } = Astro.props;
const photo = await getCategoryImage(c);
---

<a href={`/categorias/${c.slug}`} class:list={['card cc', variant, { 'has-photo': !!photo }]} style={`--c:${c.accent}`}>
  <span class="cc-bg"></span>

  <span class="cc-media">
    {photo ? (
      <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width={variant === 'wide' ? 640 : 160} height={variant === 'wide' ? 360 : 160} />
    ) : (
      <span class="cc-ph"><Icon name={c.icon} size={30} stroke={1.8} /></span>
    )}
    {photo && (
      <span class="cc-badge" aria-hidden="true"><Icon name={c.icon} size={14} stroke={2.2} /></span>
    )}
  </span>

  <span class="cc-body">
    <span class="cc-text">
      <strong>{c.name}</strong>
      {count !== undefined && <small>{count} {count === 1 ? 'producto' : 'productos'}</small>}
      {variant === 'wide' && c.description && <p>{c.description}</p>}
    </span>
    <span class="cc-arrow"><Icon name="arrow-right" size={18} /></span>
  </span>
</a>

<style>
  .cc {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    overflow: hidden;
    color: var(--ink);
  }
  .cc-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 80% at 100% 0%, color-mix(in srgb, var(--c) 14%, #fff) 0%, #fff 60%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cc:hover .cc-bg {
    opacity: 1;
  }

  /* --- Media: foto (o icono si no hay foto) --- */
  .cc-media {
    position: relative;
    flex: none;
    width: 76px;
    height: 76px;
    border-radius: 18px;
    overflow: visible;
  }
  .cc-media img,
  .cc-ph {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    background: color-mix(in srgb, var(--c) 8%, #fff);
    transition: transform 0.4s var(--ease);
  }
  .cc-ph {
    display: grid;
    place-items: center;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, #fff);
  }
  .cc:hover .cc-media img {
    transform: scale(1.06);
  }
  .cc-media img {
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04) inset;
  }
  .cc-badge {
    position: absolute;
    right: -6px;
    bottom: -6px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    box-shadow: 0 0 0 3px #fff;
    transition: transform 0.3s var(--ease);
  }
  .cc:hover .cc-badge {
    transform: rotate(-8deg) scale(1.08);
  }

  /* --- Texto --- */
  .cc-body {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }
  .cc-text {
    flex: 1;
    min-width: 0;
  }
  .cc-text strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .cc-text small {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 2px;
  }
  .cc-text p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .cc-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    color: var(--muted);
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .cc:hover .cc-arrow {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
    transform: translateX(3px);
  }

  /* --- Mobile: en grillas de 2 columnas la fila horizontal queda muy angosta,
     así que la variante "tile" pasa a foto arriba + texto abajo, igual que "wide" --- */
  @media (max-width: 640px) {
    .cc.tile {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
    }
    .cc.tile .cc-media {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }
    .cc.tile .cc-media img,
    .cc.tile .cc-ph {
      border-radius: 0;
    }
    .cc.tile .cc-badge {
      right: auto;
      left: 14px;
      bottom: -12px;
      width: 28px;
      height: 28px;
      box-shadow: 0 0 0 3px #fff;
    }
    .cc.tile .cc-body {
      padding: 22px 16px 18px;
      align-items: flex-start;
      gap: 8px;
    }
    .cc.tile .cc-text strong {
      font-size: 1rem;
    }
    .cc.tile .cc-arrow {
      width: 30px;
      height: 30px;
      margin-top: 2px;
    }
  }

  /* --- Variante ancha (/categorias): foto arriba a todo el ancho --- */
  .cc.wide {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
  }
  .cc.wide .cc-media {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 0;
    overflow: hidden;
  }
  .cc.wide .cc-media img,
  .cc.wide .cc-ph {
    border-radius: 0;
  }
  .cc.wide .cc-badge {
    right: auto;
    left: 16px;
    bottom: -14px;
    width: 34px;
    height: 34px;
    box-shadow: 0 0 0 4px #fff;
  }
  .cc.wide .cc-body {
    padding: 26px 22px 22px;
    align-items: flex-start;
  }
  .cc.wide .cc-text strong {
    font-size: 1.25rem;
  }
  .cc.wide .cc-arrow {
    margin-top: 2px;
  }
</style>
