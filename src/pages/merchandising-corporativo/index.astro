---
/**
 * Landing B2B (/merchandising-corporativo): merchandising y productos personalizados
 * para empresas, impresos en 3D. Cubre tanto lo que la empresa entrega (llaveros,
 * soportes, welcome packs) como lo que usa en su local (displays QR, señalética).
 * Objetivo: captar cotizaciones por volumen, no vender por carrito.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE, whatsappLink } from '@/config';
import { corpLines, volumeTiers, sectors, lineImage } from '@/data/corporativo';

const clp = (n: number) => '$' + n.toLocaleString('es-CL');

const landingNav = [
  { href: '#lineas', label: 'Líneas' },
  { href: '#porque', label: 'Por qué 3D' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#volumen', label: 'Precios' },
  { href: '#faq', label: 'Preguntas' },
  { href: '#cotizar', label: 'Cotizar' },
];

const slides = [
  { src: '/empresa/hero-escritorio.webp', caption: 'Escritorio y oficina', alt: 'Soporte de celular, display QR y portalápices impresos en 3D con logo corporativo sobre un escritorio' },
  { src: '/empresa/hero-recepcion.webp', caption: 'Recepción y señalética', alt: 'Logotipo corporativo impreso en 3D sobre el mesón de recepción de una empresa' },
  { src: '/empresa/hero-produccion.webp', caption: 'Producción por lotes', alt: 'Lote de soportes y llaveros impresos en 3D siendo empacados en cajas kraft' },
];

const steps = [
  { n: 1, title: 'Cuéntanos qué necesitas', text: 'Cantidad aproximada, para qué ocasión y tu logo en PNG, SVG o AI. Si no sabes qué producto elegir, te proponemos opciones según presupuesto.' },
  { n: 2, title: 'Recibes propuesta y render', text: 'En menos de 24 horas te enviamos precio por unidad, plazo y una vista previa de tu logo aplicado en la pieza.' },
  { n: 3, title: 'Aprobamos una muestra física', text: 'Imprimimos una unidad real con tu logo y te la enviamos antes de producir el lote. Nada se fabrica en serie sin tu visto bueno.' },
  { n: 4, title: 'Producción y entrega', text: 'Fabricamos el lote, lo empacamos y lo despachamos a todo Chile. Emitimos factura electrónica.' },
];

const reasons = [
  { icon: 'zap', title: 'Sin costo de matricería', text: 'El merchandising tradicional te cobra el molde antes de la primera unidad. En impresión 3D el molde no existe: pagas solo las piezas que necesitas.' },
  { icon: 'filter', title: 'Desde 5 unidades', text: 'No necesitas pedir 500 artículos para que el precio tenga sentido. Producimos lotes chicos, desde 5 piezas, y repones cuando se te acaben.' },
  { icon: 'users', title: 'Personalización uno a uno', text: 'Cada pieza puede llevar el nombre de una persona distinta sin recargo. Imposible de hacer con serigrafía o inyección.' },
  { icon: 'truck', title: 'Producción local en Chile', text: 'Sin importaciones ni esperas de tres meses. Fabricamos acá y entregamos en días, no en semanas.' },
];

const faqs = [
  {
    q: '¿Cuál es la cantidad mínima?',
    a: 'Baja a propósito, porque muchas empresas parten con poco: desde 5 unidades en displays QR, posavasos y welcome packs, 10 en soportes y portatarjetas, 25 en llaveros y organizadores. Los trofeos se hacen desde 3 y los logotipos 3D desde 1. Si necesitas menos, igual escríbenos.',
  },
  {
    q: '¿En qué formato les envío el logo de mi empresa?',
    a: 'Lo ideal es SVG, AI, EPS o PDF vectorial, porque permite el máximo detalle en el relieve. También trabajamos con PNG de buena resolución y fondo transparente. Si solo tienes el logo en baja calidad, lo vectorizamos nosotros sin costo.',
  },
  {
    q: '¿Cuánto demora un pedido para empresas?',
    a: 'La muestra física llega en 3 a 5 días hábiles. Una vez aprobada, un pedido de hasta 25 unidades toma 3 a 7 días hábiles; lotes mayores los programamos y te confirmamos el plazo al cotizar. Para fin de año conviene cotizar en octubre.',
  },
  {
    q: '¿Pueden usar los colores exactos de mi marca?',
    a: 'Trabajamos con más de 20 colores de filamento y buscamos el más cercano a tu paleta. Para colores muy específicos hacemos pintura sobre la pieza. En la muestra física verás el color real antes de producir el lote.',
  },
  {
    q: '¿Emiten factura y trabajan con orden de compra?',
    a: 'Sí, emitimos factura electrónica y aceptamos orden de compra. Trabajamos con empresas de cualquier tamaño, desde emprendimientos que recién se formalizan hasta compañías con departamento de compras. El estándar es 50 % al aprobar la muestra y 50 % contra entrega, aunque lo ajustamos según las condiciones de pago de tu empresa.',
  },
  {
    q: '¿Incluyen el empaque?',
    a: 'El empaque de protección para el envío va incluido. El empaque de presentación (caja kraft con ventana, viruta de papel y sello de tu marca) es opcional y se cotiza aparte: suele agregar entre $900 y $2.500 por unidad, y cambia por completo cómo se percibe la pieza.',
  },
];

const wa = (line?: string) =>
  whatsappLink(
    line
      ? `Hola, quiero cotizar ${line} para mi empresa. Te cuento: `
      : 'Hola, quiero cotizar merchandising corporativo impreso en 3D. Te cuento: ',
  );

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Merchandising corporativo impreso en 3D',
    serviceType: 'Merchandising y productos personalizados para empresas',
    provider: { '@type': 'LocalBusiness', name: SITE.name, url: SITE.url, telephone: SITE.phone, areaServed: 'CL' },
    areaServed: { '@type': 'Country', name: 'Chile' },
    url: `${SITE.url}/merchandising-corporativo`,
    description:
      'Merchandising, señalética y productos personalizados impresos en 3D con el logo de tu empresa. Producción local en Chile desde 5 unidades, sin costo de matricería.',
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'CLP',
      lowPrice: 990,
      highPrice: 49000,
      offerCount: corpLines.length,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Empresas', item: `${SITE.url}/merchandising-corporativo` },
    ],
  },
];
---

<BaseLayout
  title="Merchandising corporativo impreso en 3D"
  description="Merchandising corporativo impreso en 3D con el logo de tu empresa: displays QR, soportes de celular, llaveros, señalética, tarjeteros y welcome packs. Desde 5 unidades, envíos a todo Chile."
  jsonLd={jsonLd}
  chrome="landing"
  landingNav={landingNav}
>
  <!-- Hero con slider -->
  <section class="hero" id="hero" data-hero>
    <div class="hero-slides" aria-hidden="true">
      {
        slides.map((sl, i) => (
          <div class:list={['hero-slide', { 'is-active': i === 0 }]} data-slide={i}>
            <img
              src={sl.src}
              alt={sl.alt}
              width="1920"
              height="1080"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
            />
          </div>
        ))
      }
      <div class="hero-shade"></div>
    </div>

    <div class="container hero-inner">
      <span class="eyebrow light">Para empresas</span>
      <h1>Merchandising corporativo impreso en 3D</h1>
      <p class="hero-text">
        Productos personalizados con el logo de tu empresa: para entregar a clientes y equipo, y para usar en tu
        propio local. Fabricados en Chile, sin costo de matricería, desde 5 unidades y con muestra física antes de producir el lote.
      </p>
      <div class="hero-actions">
        <a class="btn btn-whatsapp btn-lg" href={wa()} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> Cotizar por WhatsApp
        </a>
        <a class="btn btn-outline-light btn-lg" href="#lineas">Ver las líneas <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="hero-chips">
        <li><Icon name="check" size={16} /> Desde 5 unidades</li>
        <li><Icon name="check" size={16} /> Sin costo de matricería</li>
        <li><Icon name="check" size={16} /> Factura electrónica</li>
      </ul>

      <div class="hero-nav">
        <span class="hero-caption" data-caption>{slides[0].caption}</span>
        <div class="hero-dots" role="tablist" aria-label="Imágenes del hero">
          {
            slides.map((sl, i) => (
              <button
                type="button"
                role="tab"
                class:list={['hero-dot', { 'is-active': i === 0 }]}
                data-dot={i}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={sl.caption}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Barra de confianza -->
  <section class="trust">
    <div class="container trust-inner">
      <span><Icon name="check" size={18} /> Muestra física antes de producir</span>
      <span><Icon name="zap" size={18} /> Cotización en menos de 24 h</span>
      <span><Icon name="truck" size={18} /> Despacho a todo Chile</span>
      <span><Icon name="shield" size={18} /> Factura electrónica y orden de compra</span>
    </div>
  </section>

  <!-- Líneas -->
  <section class="section" id="lineas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Para empresas</span>
        <h2>Qué fabricamos para empresas</h2>
        <p>
          Sirve igual para una empresa que recién parte y necesita sus primeras piezas con marca, como para una que ya
          tiene su identidad definida y quiere reponer. Los precios son referenciales por unidad, a partir de la cantidad
          mínima de cada línea; el valor final depende del volumen, los colores y el detalle del logo.
        </p>
      </div>

      <div class="grid grid-3">
        {
          corpLines.map((l, i) => (
            <article class:list={['card line reveal', { hot: l.featured }]} style={`transition-delay:${(i % 3) * 80}ms`}>
              <a class="line-media" href={wa(l.name.toLowerCase())} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={lineImage(l)} alt={l.name} width="1200" height="900" loading="lazy" decoding="async" />
                {l.featured && <span class="line-tag">Más pedido</span>}
                <span class="line-icon">
                  <Icon name={l.icon} size={20} stroke={2} />
                </span>
              </a>
              <div class="line-body">
              <h3>{l.name}</h3>
              <p class="line-text">{l.text}</p>
              <ul>
                {l.bullets.map((b) => (
                  <li>
                    <Icon name="check" size={16} /> {b}
                  </li>
                ))}
              </ul>
              <div class="line-foot">
                <span class="line-price">
                  <small>desde</small>
                  <b>{clp(l.from)}</b>
                  <small>por {l.unit}</small>
                </span>
                <span class="line-min">mín. {l.min} {l.min === 1 ? 'unidad' : 'unidades'}</span>
              </div>
              <a class="btn btn-outline btn-sm line-cta" href={wa(l.name.toLowerCase())} target="_blank" rel="noopener">
                Cotizar esta línea <Icon name="arrow-right" size={16} />
              </a>
              </div>
            </article>
          ))
        }
      </div>

      <p class="lines-note">
        ¿Tu empresa necesita algo que no está en la lista? Diseñamos la pieza desde cero: exhibidores, repuestos con tu
        marca, maquetas o piezas técnicas. <a href={wa()} target="_blank" rel="noopener">Cuéntanos la idea</a>.
      </p>
    </div>
  </section>

  <!-- Por qué 3D -->
  <section class="section bg-soft" id="porque">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Por qué en 3D</span>
        <h2>Qué gana tu empresa frente al merchandising tradicional</h2>
      </div>
      <div class="grid grid-4">
        {
          reasons.map((r, i) => (
            <article class="card why reveal" style={`transition-delay:${(i % 4) * 70}ms`}>
              <span class="why-icon">
                <Icon name={r.icon} size={22} stroke={1.9} />
              </span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section" id="proceso">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cómo trabajamos</span>
        <h2>Cómo trabajamos con tu empresa, paso a paso</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="card step reveal">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Volumen -->
  <section class="section bg-soft" id="volumen">
    <div class="container narrow-md">
      <div class="section-head">
        <span class="eyebrow">Precio por volumen</span>
        <h2>Precio según cantidad</h2>
        <p>Partimos con lotes chicos y el valor unitario baja a medida que tu empresa pide más. Descuentos referenciales sobre el precio base de cada línea.</p>
      </div>
      <div class="tiers">
        {
          volumeTiers.map((t) => (
            <div class="card tier">
              <span class="tier-range">{t.range} <small>unidades</small></span>
              <b class="tier-off">{t.discount}</b>
              <span class="tier-note">{t.note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sectores -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Tipos de empresa</span>
        <h2>Para qué tipo de empresa funciona mejor</h2>
      </div>
      <div class="grid grid-3">
        {
          sectors.map((s, i) => (
            <article class="card sector reveal" style={`transition-delay:${(i % 3) * 70}ms`}>
              <span class="sector-icon">
                <Icon name={s.icon} size={20} stroke={1.9} />
              </span>
              <div>
                <h3>{s.name}</h3>
                <p>{s.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cotizar -->
  <section class="section cta-band" id="cotizar">
    <div class="container cta-inner">
      <div>
        <span class="eyebrow light">Cotiza sin compromiso</span>
        <h2>Cuéntanos qué necesita tu empresa y te respondemos hoy</h2>
        <p>
          Escríbenos con la cantidad aproximada, para qué la necesitas y el logo de tu empresa. Te enviamos precio por
          unidad, plazo y una vista previa con tu marca aplicada. Si el proyecto avanza, imprimimos una muestra física
          antes de producir el lote.
        </p>
        <div class="cta-actions">
          <a class="btn btn-whatsapp btn-lg" href={wa()} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Cotizar por WhatsApp
          </a>
          <a class="btn btn-outline-light btn-lg" href={`mailto:${SITE.email}?subject=Cotización merchandising corporativo 3D`}>
            <Icon name="mail" /> Escribir por correo
          </a>
        </div>
        <p class="cta-phone">
          <Icon name="phone" size={16} /> También puedes llamarnos al <a href={SITE.phoneHref}>{SITE.phone}</a>
        </p>
      </div>
      <aside class="card cta-card">
        <h3>Para cotizar más rápido, ten a mano</h3>
        <ul>
          <li><Icon name="check" size={16} /> Cantidad aproximada de unidades</li>
          <li><Icon name="check" size={16} /> Fecha en que las necesitas</li>
          <li><Icon name="check" size={16} /> Logo de la empresa en SVG, AI o PNG</li>
          <li><Icon name="check" size={16} /> Colores corporativos</li>
          <li><Icon name="check" size={16} /> Si necesitas empaque de presentación</li>
        </ul>
        <p class="cta-note">
          ¿Tu empresa aún no define qué producto conviene? Dinos el presupuesto por persona y te proponemos tres alternativas.
        </p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container narrow-md">
      <div class="section-head">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Lo que nos preguntan las empresas</h2>
      </div>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>
                {f.q} <Icon name="chevron-down" size={20} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="faq-more">
        ¿Tienes otra duda? <a href={wa()} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> y te respondemos hoy.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Barra de confianza */
  .trust {
    border-bottom: 1px solid var(--border);
    background: #fff;
  }
  .trust-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 34px;
    padding: 16px 0;
  }
  .trust-inner span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .trust-inner svg {
    color: var(--success);
    flex: none;
  }

  section[id] {
    scroll-margin-top: 84px;
  }

  /* Hero slider */
  .hero {
    position: relative;
    min-height: min(78vh, 720px);
    display: flex;
    align-items: center;
    background: var(--ink);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-slides {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .hero-slide.is-active {
    opacity: 1;
  }
  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    transform: scale(1.04);
    transition: transform 8s linear;
  }
  .hero-slide.is-active img {
    transform: scale(1.12);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(17, 19, 22, 0.92) 0%, rgba(17, 19, 22, 0.78) 38%, rgba(17, 19, 22, 0.25) 70%, rgba(17, 19, 22, 0.1) 100%),
      linear-gradient(0deg, rgba(17, 19, 22, 0.55) 0%, rgba(17, 19, 22, 0) 40%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding: 56px 0 44px;
    max-width: 640px;
    margin-left: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    margin-right: auto;
  }
  .crumbs ol {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    opacity: 0.5;
  }
  .crumbs a {
    color: inherit;
  }
  .eyebrow.light {
    color: rgba(255, 255, 255, 0.9);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin: 10px 0 16px;
  }
  .hero-text {
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 56ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 26px 0 22px;
  }
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .hero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.86rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
  }
  .hero-chips svg {
    color: #4ade80;
  }
  .hero-nav {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 34px;
  }
  .hero-caption {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .hero-dots {
    display: flex;
    gap: 8px;
  }
  .hero-dot {
    width: 28px;
    height: 4px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: background 0.3s, width 0.3s;
  }
  .hero-dot.is-active {
    background: #fff;
    width: 44px;
  }

  /* Líneas */
  .line {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .line.hot {
    border-color: color-mix(in srgb, var(--blue) 35%, var(--border));
    box-shadow: 0 10px 30px rgba(21, 101, 216, 0.1);
  }
  .line-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .line-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease);
  }
  .line:hover .line-media img {
    transform: scale(1.05);
  }
  .line-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: var(--blue);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(21, 101, 216, 0.35);
  }
  .line-icon {
    position: absolute;
    right: 14px;
    bottom: -18px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #fff;
    color: var(--blue);
    box-shadow: var(--shadow);
  }
  .line-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 26px 24px 24px;
