---
/**
 * Landing SEO (/logo-3d-empresas): el logo de la empresa convertido en pieza física
 * impresa en 3D. Foco en formato pequeño/mediano (regalo a clientes, escritorio) y
 * el logo grande para recepción como extra. Complementa /merchandising-corporativo:
 * esta página responde a la búsqueda "logo 3d empresa"; la otra, a merchandising en general.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE, whatsappLink } from '@/config';
import { volumeTiers } from '@/data/corporativo';

const clp = (n: number) => '$' + n.toLocaleString('es-CL');

const landingNav = [
  { href: '#formatos', label: 'Formatos' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#volumen', label: 'Precios' },
  { href: '#escritorio', label: 'Logos grandes' },
  { href: '#faq', label: 'Preguntas' },
  { href: '#cotizar', label: 'Cotizar' },
];

const slides = [
  { src: '/empresa/hero-escritorio.webp', caption: 'Para escritorio y clientes', alt: 'Soporte de celular y piezas con logo corporativo impresas en 3D sobre un escritorio de oficina' },
  { src: '/empresa/hero-recepcion.webp', caption: 'Para recepción', alt: 'Logo de empresa impreso en 3D sobre el mesón de recepción' },
];

const formats = [
  {
    slug: 'soportes-celular',
    icon: 'phone',
    name: 'Portacelular con logo',
    text: 'El regalo que se usa todos los días y deja tu marca a la vista sobre el escritorio del cliente.',
    bullets: ['Logo en relieve o bajo relieve en la base', 'Sirve para cualquier teléfono, con o sin carcasa', 'Ranura libre para el cable de carga'],
    price: 2900,
    unit: 'unidad',
    min: 10,
    featured: true,
  },
  {
    slug: 'llaveros',
    icon: 'key',
    name: 'Llavero con logo 3D',
    text: 'Tu logo en forma de llavero: el detalle de bajo costo para entregar en ferias, visitas y aniversarios.',
    bullets: ['Logo recortado con la forma de tu marca', 'Colores cercanos a tu paleta corporativa', 'Nombre individual sin costo extra'],
    price: 1490,
    unit: 'unidad',
    min: 25,
  },
  {
    slug: 'portatarjetas',
    icon: 'card',
    name: 'Portatarjetas con logo',
    text: 'Tarjetero de sobremesa con tu marca en el frente, para mesón de atención o escritorio de ventas.',
    bullets: ['Capacidad para 30 a 40 tarjetas', 'Logo integrado en el frente', 'Se entrega listo para usar'],
    price: 3900,
    unit: 'unidad',
    min: 10,
  },
  {
    slug: 'posavasos',
    icon: 'layers',
    name: 'Posavasos con logo',
    text: 'Set de 4 posavasos con soporte propio y tu logo en la cara superior, en los colores de la marca.',
    bullets: ['Base antideslizante', 'Soporte apilable a juego', 'Terminación premium para regalo'],
    price: 12900,
    unit: 'set de 4',
    min: 5,
  },
];

const deskSizes = [
  { name: 'Estándar', size: 'Hasta 20 cm de ancho', price: 32900, note: 'El tamaño más pedido para escritorio, mesón o vitrina.' },
  { name: 'Grande', size: 'Hasta 28 cm de ancho', price: 39900, note: 'Más presencia para stands, ferias y puntos de venta.' },
];

const deskIncludes = [
  'Logo en relieve con base integrada, listo para exhibir',
  'Hasta 3 colores incluidos',
  'Vectorización de tu logo sin costo si no tienes el archivo',
  'Vista previa (render) antes de imprimir',
];

const steps = [
  { n: 1, title: 'Envías tu logo', text: 'Por WhatsApp, en SVG, AI, PDF o PNG de buena calidad. Si solo tienes una imagen pequeña, la vectorizamos sin costo.' },
  { n: 2, title: 'Recibes cotización y render', text: 'Te enviamos precio por unidad, plazo y una vista previa de tu logo aplicado en la pieza que elijas.' },
  { n: 3, title: 'Aprobamos una muestra', text: 'Imprimimos una unidad real y te la enviamos. No se fabrica el lote sin tu visto bueno.' },
  { n: 4, title: 'Producción y entrega', text: 'Fabricamos el lote, lo empacamos y lo despachamos a todo Chile.' },
];

const reasons = [
  { icon: 'zap', title: 'Sin costo de molde', text: 'En impresión 3D no existe matricería: pagas solo las piezas que necesitas, aunque sean pocas.' },
  { icon: 'filter', title: 'Desde pocas unidades', text: 'Puedes partir con 1 logo de escritorio o con un lote chico de 10 a 25 regalos, y reponer cuando quieras.' },
  { icon: 'users', title: 'Un nombre por pieza', text: 'Cada regalo puede llevar el nombre del cliente o del equipo, sin recargo.' },
  { icon: 'truck', title: 'Hecho en Chile', text: 'Producimos en Temuco y despachamos a todo el país, sin importaciones ni esperas largas.' },
];

const faqs = [
  {
    q: '¿Qué es un logo 3D impreso para empresa?',
    a: 'Es una pieza física: el logo de tu empresa fabricado en relieve con impresión 3D, que puedes poner en tu escritorio, recepción o entregar como regalo corporativo. No es un diseño digital con efecto 3D para redes o web.',
  },
  {
    q: '¿Qué archivo necesito para hacer el logo en 3D?',
    a: 'Lo ideal es un archivo vectorial (SVG, AI, EPS o PDF). También sirve un PNG de buena resolución con fondo transparente. Si solo tienes una imagen pequeña, la vectorizamos nosotros sin costo.',
  },
  {
    q: '¿Qué tamaños de logo se pueden hacer?',
    a: 'Desde piezas pequeñas para regalar (llaveros y portacelulares), pasando por logos de escritorio de hasta 20 o 28 cm de ancho, hasta piezas grandes para recepción de hasta 60 cm, ensambladas. Los logos grandes se cotizan según tamaño y detalle.',
  },
  {
    q: '¿Cuánto cuesta un logo 3D para empresa?',
    a: 'Depende del tamaño, los colores y el detalle del logo. Como referencia: un llavero parte desde $1.490 por unidad en lotes de 25, un portacelular desde $2.900 en lotes de 10, un logo de escritorio cuesta $32.900 (hasta 20 cm) o $39.900 (hasta 28 cm), y un logo grande de recepción parte desde $49.000. Emitimos boleta. Cotiza gratis por WhatsApp con tu logo.',
  },
  {
    q: '¿Hacen pedidos por volumen para regalos a clientes?',
    a: 'Sí. Para llaveros desde 25 unidades, para portacelulares desde 10, y el precio por unidad baja a medida que aumenta la cantidad. Para regalos de fin de año conviene cotizar en octubre.',
  },
  {
    q: '¿Cuánto demora y despachan a todo Chile?',
    a: 'La muestra física llega en 3 a 5 días hábiles. Un pedido de hasta 25 unidades toma 3 a 7 días hábiles una vez aprobada la muestra; lotes mayores los programamos y te confirmamos el plazo al cotizar. Despachamos a todo Chile.',
  },
];

const wa = (what?: string) =>
  whatsappLink(
    what
      ? `Hola, quiero cotizar ${what} con el logo de mi empresa. Te cuento: `
      : 'Hola, quiero cotizar mi logo de empresa impreso en 3D. Te cuento: ',
  );

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Logo 3D impreso para empresas',
    serviceType: 'Logos corporativos y regalos con logo impresos en 3D',
    provider: { '@type': 'LocalBusiness', name: SITE.name, url: SITE.url, telephone: SITE.phone, areaServed: 'CL' },
    areaServed: { '@type': 'Country', name: 'Chile' },
    url: `${SITE.url}/logo-3d-empresas`,
    description:
      'Convertimos el logo de tu empresa en una pieza física impresa en 3D: logo de escritorio, portacelular, llavero o logo grande para recepción. Producción local en Chile.',
    offers: [
      { '@type': 'Offer', name: 'Logo 3D de escritorio (hasta 20 cm)', price: 32900, priceCurrency: 'CLP' },
      { '@type': 'Offer', name: 'Logo 3D de escritorio (hasta 28 cm)', price: 39900, priceCurrency: 'CLP' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Logo 3D para empresas', item: `${SITE.url}/logo-3d-empresas` },
    ],
  },
];
---

<BaseLayout
  title="Logo 3D para Empresas: Regalos Corporativos Impresos"
  description="Convertimos el logo de tu empresa en una pieza 3D impresa: regalos para clientes, llaveros, portacelulares y logos grandes. Cotiza por WhatsApp con tu archivo."
  jsonLd={jsonLd}
  chrome="landing"
  landingNav={landingNav}
>
  <!-- Hero con slider -->
  <section class="hero" id="hero" data-hero>
    <div class="hero-slides" aria-hidden="true">
      {
        slides.map((sl, i) => (
          <div class:list={['hero-slide', { 'is-active': i === 0 }]} data-slide={i}>
            <img
              src={sl.src}
              alt={sl.alt}
              width="1920"
              height="1080"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
            />
          </div>
        ))
      }
      <div class="hero-shade"></div>
    </div>

    <div class="container hero-inner">
      <span class="eyebrow light">Logo 3D para empresas</span>
      <h1>Logo 3D de tu empresa en pieza impresa: regalos para clientes y escritorio</h1>
      <p class="hero-text">
        Transformamos el logo de tu empresa en una pieza física impresa en 3D: un regalo que tus clientes usan todos los
        días, un logo para tu escritorio o uno grande para tu recepción. Envíanos tu logo y te cotizamos por WhatsApp.
      </p>
      <div class="hero-actions">
        <a class="btn btn-whatsapp btn-lg" href={wa()} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> Cotizar mi logo por WhatsApp
        </a>
        <a class="btn btn-outline-light btn-lg" href="#formatos">Ver formatos <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="hero-chips">
        <li><Icon name="check" size={16} /> Desde 1 unidad</li>
        <li><Icon name="check" size={16} /> Sin costo de molde</li>
        <li><Icon name="check" size={16} /> Muestra antes del lote</li>
      </ul>

      <div class="hero-nav">
        <span class="hero-caption" data-caption>{slides[0].caption}</span>
        <div class="hero-dots" role="tablist" aria-label="Imágenes del hero">
          {
            slides.map((sl, i) => (
              <button
                type="button"
                role="tab"
                class:list={['hero-dot', { 'is-active': i === 0 }]}
                data-dot={i}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={sl.caption}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Barra de confianza -->
  <section class="trust">
    <div class="container trust-inner">
      <span><Icon name="check" size={18} /> Muestra física antes de producir</span>
      <span><Icon name="zap" size={18} /> Cotización en menos de 24 h</span>
      <span><Icon name="truck" size={18} /> Despacho a todo Chile</span>
      <span><Icon name="shield" size={18} /> Producción local en Chile</span>
    </div>
  </section>

  <!-- Qué es -->
  <section class="section">
    <div class="container narrow-md">
      <div class="section-head">
        <span class="eyebrow">Qué es</span>
        <h2>Qué es un logo 3D impreso para empresa</h2>
        <p>
          Es tu logo hecho objeto: una pieza física en relieve, fabricada con impresión 3D en los colores de tu marca.
          No es un diseño digital con efecto 3D para redes o web: es algo que se toca, se exhibe y se regala. Lo más
          pedido es en formato pequeño o mediano, como regalo a clientes o pieza de escritorio; si necesitas un logo
          grande para recepción, también lo hacemos.
        </p>
      </div>
    </div>
  </section>

  <!-- Formatos -->
  <section class="section bg-soft" id="formatos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Formatos</span>
        <h2>Tu logo en el objeto que tus clientes van a usar</h2>
        <p>
          Cada formato es una base probada a la que le aplicamos tu logo, así el precio por volumen es claro y la
          cotización rápida. Los precios son referenciales por unidad; el valor final depende de la cantidad, los
          colores y el detalle del logo.
        </p>
      </div>

      <div class="grid grid-4">
        {
          formats.map((l, i) => (
            <article class:list={['card line reveal', { hot: l.featured }]} style={`transition-delay:${(i % 3) * 80}ms`}>
              <a class="line-media" href={wa(l.name.toLowerCase())} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={`/empresa/${l.slug}.webp`} alt={`${l.name}: pieza impresa en 3D`} width="1200" height="900" loading="lazy" decoding="async" />
                {l.featured && <span class="line-tag">Más pedido</span>}
                <span class="line-icon">
                  <Icon name={l.icon} size={20} stroke={2} />
                </span>
              </a>
              <div class="line-body">
                <h3>{l.name}</h3>
                <p class="line-text">{l.text}</p>
                <ul>
                  {l.bullets.map((b) => (
                    <li>
                      <Icon name="check" size={16} /> {b}
                    </li>
                  ))}
                </ul>
                <div class="line-foot">
                  {l.price ? (
                    <span class="line-price">
                      <small>desde</small>
                      <b>{clp(l.price)}</b>
                      <small>por {l.unit}</small>
                    </span>
                  ) : (
                    <span class="line-price">
                      <b>A cotizar</b>
                      <small>según tamaño y colores</small>
                    </span>
                  )}
                  <span class="line-min">mín. {l.min} {l.min === 1 ? 'unidad' : 'unidades'}</span>
                </div>
                <a class="btn btn-outline btn-sm line-cta" href={wa(l.name.toLowerCase())} target="_blank" rel="noopener">
                  Cotizar este formato <Icon name="arrow-right" size={16} />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <p class="lines-note">
        ¿Buscas otros productos con tu marca, como displays QR, trofeos o welcome packs? Mira todo el
        <a href="/merchandising-corporativo">merchandising corporativo impreso en 3D</a>.
      </p>
    </div>
  </section>

  <!-- Por qué 3D -->
  <section class="section bg-soft" id="porque">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Por qué en 3D</span>
        <h2>Qué gana tu empresa con un logo impreso en 3D</h2>
      </div>
      <div class="grid grid-4">
        {
          reasons.map((r, i) => (
            <article class="card why reveal" style={`transition-delay:${(i % 4) * 70}ms`}>
              <span class="why-icon">
                <Icon name={r.icon} size={22} stroke={1.9} />
              </span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section" id="proceso">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cómo lo hacemos</span>
        <h2>Cómo hacemos tu logo 3D, en 4 pasos</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="card step reveal">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Volumen -->
  <section class="section bg-soft" id="volumen">
    <div class="container narrow-md">
      <div class="section-head">
        <span class="eyebrow">Precio por volumen</span>
        <h2>Mientras más regalos, menor el precio por unidad</h2>
        <p>Descuentos referenciales sobre el precio base de cada formato.</p>
      </div>
      <div class="tiers">
        {
          volumeTiers.map((t) => (
            <div class="card tier">
              <span class="tier-range">{t.range} <small>unidades</small></span>
              <b class="tier-off">{t.discount}</b>
              <span class="tier-note">{t.note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Logo de escritorio: tamaños y precios -->
  <section class="section" id="escritorio">
    <div class="container narrow-md">
      <div class="section-head">
        <span class="eyebrow">Logos grandes</span>
        <h2>¿Necesitas un logo más grande? Escritorio, mesón y stand</h2>
        <p>
          Además de los regalos pequeños, fabricamos tu logo en tamaño grande con base propia, para oficina, mesón de
          atención, vitrina o stand. Son precios por unidad desde 1 pieza; si pides varias, el valor baja según la cantidad.
        </p>
      </div>
      <div class="sizes">
        {
          deskSizes.map((d) => (
            <div class="card size">
              <span class="size-name">{d.name}</span>
              <span class="size-dim">{d.size}</span>
              <b class="size-price">{clp(d.price)}</b>
              <span class="size-note">{d.note}</span>
              <a class="btn btn-outline btn-sm" href={wa(`un logo 3D de escritorio ${d.name.toLowerCase()} (${d.size.toLowerCase()})`)} target="_blank" rel="noopener">
                Cotizar este tamaño <Icon name="arrow-right" size={16} />
              </a>
            </div>
          ))
        }
      </div>
      <div class="desk-extra">
        <div class="card desk-box">
          <h3>Qué incluye</h3>
          <ul>
            {deskIncludes.map((i) => <li><Icon name="check" size={16} /> {i}</li>)}
          </ul>
        </div>
        <div class="card desk-box">
          <h3>Revisamos tu logo antes de imprimir</h3>
          <p>
            Algunos logos tienen líneas muy finas, letras pequeñas o partes que quedarían sueltas. Antes de producir
            revisamos el diseño y, si hace falta, te proponemos un pequeño ajuste para que la pieza quede firme y se
            vea bien. Tú apruebas el render y la muestra antes del lote.
          </p>
          <p class="desk-care">
            <b>Cuidado:</b> son piezas para interior. Evita dejarlas al sol directo o cerca de fuentes de calor intenso.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Logo grande -->
  <section class="section" id="grande">
    <div class="container big">
      <div class="big-media">
        <img src="/empresa/hero-recepcion.webp" alt="Logo de empresa en 3D de gran tamaño sobre el mesón de recepción" width="1920" height="1080" loading="lazy" decoding="async" />
      </div>
      <div class="big-body">
        <span class="eyebrow">Para recepción</span>
        <h2>Logo gigante para recepción</h2>
        <p>
          También fabricamos el logo de tu empresa en tamaño grande para recepción, sala de reuniones o vitrina: de
          sobremesa con base propia o para montar en pared, de hasta 60 cm de ancho en piezas ensambladas. Se cotiza
          según tamaño y detalle, desde {clp(49000)}.
        </p>
        <a class="btn btn-primary" href={wa('un logo 3D grande para recepción')} target="_blank" rel="noopener">
          Cotizar logo grande <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Cotizar -->
  <section class="section cta-band" id="cotizar">
    <div class="container cta-inner">
      <div>
        <span class="eyebrow light">Cotiza gratis</span>
        <h2>Cotiza tu logo 3D</h2>
        <p>
          Escríbenos por WhatsApp con tu logo, la cantidad aproximada y para qué lo necesitas. Te enviamos precio por
          unidad, plazo y una vista previa con tu marca aplicada.
        </p>
        <div class="cta-actions">
          <a class="btn btn-whatsapp btn-lg" href={wa()} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Cotizar por WhatsApp
          </a>
          <a class="btn btn-outline-light btn-lg" href={`mailto:${SITE.email}?subject=Cotización logo 3D para empresa`}>
            <Icon name="mail" /> Escribir por correo
          </a>
        </div>
        <p class="cta-phone">
          <Icon name="phone" size={16} /> También puedes llamarnos al <a href={SITE.phoneHref}>{SITE.phone}</a>
        </p>
      </div>
      <aside class="card cta-card">
        <h3>Para cotizar más rápido, ten a mano</h3>
        <ul>
          <li><Icon name="check" size={16} /> Tu logo en SVG, AI, PDF o PNG</li>
          <li><Icon name="check" size={16} /> Cantidad aproximada</li>
          <li><Icon name="check" size={16} /> Fecha en que lo necesitas</li>
          <li><Icon name="check" size={16} /> Colores de tu marca</li>
        </ul>
        <p class="cta-note">
          ¿No sabes qué formato conviene? Dinos tu presupuesto por regalo y te proponemos alternativas.
        </p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container narrow-md">
      <div class="section-head">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Preguntas frecuentes sobre logos 3D para empresas</h2>
      </div>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>
                {f.q} <Icon name="chevron-down" size={20} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="faq-more">
        ¿Tienes otra duda? <a href={wa()} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> y te respondemos hoy.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Barra de confianza */
  .trust {
    border-bottom: 1px solid var(--border);
    background: #fff;
  }
  .trust-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 34px;
    padding: 16px 0;
  }
  .trust-inner span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .trust-inner svg {
    color: var(--success);
    flex: none;
  }

  section[id] {
    scroll-margin-top: 84px;
  }

  /* Hero slider */
  .hero {
    position: relative;
    min-height: min(78vh, 720px);
    display: flex;
    align-items: center;
    background: var(--ink);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-slides {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .hero-slide.is-active {
