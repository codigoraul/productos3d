---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Blog de impresión 3D"
  description="Guías y consejos sobre impresión 3D en Chile: regalos corporativos con logo, merchandising, archivos para imprimir y más."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog de Productos 3D',
    url: 'https://productos3d.cl/blog',
    inLanguage: 'es-CL',
  }}
>
  <PageHero
    eyebrow="Blog"
    title="Ideas y guías de impresión 3D"
    text="Consejos prácticos para empresas y emprendedores: regalos con logo, merchandising y cómo preparar tus archivos."
    crumbs={[{ label: 'Blog' }]}
  />

  <section class="section">
    <div class="container">
      {posts.length === 0 && <p>Pronto publicaremos nuestros primeros artículos.</p>}
      <ul class="post-grid">
        {
          posts.map((p) => (
            <li class="card post-card">
              {p.data.image && (
                <a href={`/blog/${p.id}`} tabindex="-1" aria-hidden="true">
                  <img src={p.data.image} alt="" width="640" height="360" loading="lazy" />
                </a>
              )}
              <div class="post-body">
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <h2>
                  <a href={`/blog/${p.id}`}>{p.data.title}</a>
                </h2>
                <p>{p.data.description}</p>
                <a class="more" href={`/blog/${p.id}`}>Leer artículo →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .post-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .post-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .post-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .post-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  time {
    font-size: 0.85rem;
    color: var(--muted);
  }
  h2 {
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0;
  }
  h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--blue);
  }
  p {
    margin: 0;
    color: var(--ink-2);
  }
  .more {
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
    margin-top: 4px;
  }
</style>
