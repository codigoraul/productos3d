---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CatalogGrid from '@/components/CatalogGrid.astro';
import Icon from '@/components/Icon.astro';
import { getCategories, getCategory, getCategoryCounts, getProductsByCategory } from '@/lib/catalog';
import { getCategorySeo } from '@/lib/seo';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = (await getCategory(slug!))!;
const categories = await getCategories();
const counts = await getCategoryCounts();
const products = await getProductsByCategory(category.slug);
const others = categories.filter((c) => c.slug !== category.slug);
const seo = await getCategorySeo(category.id);
---

<BaseLayout
  title={seo?.title ?? category.name}
  description={seo?.description ?? category.description}
  image={seo?.ogImage}
  suffix={!seo?.title}
>
  <PageHero
    eyebrow={`${products.length} ${products.length === 1 ? 'producto' : 'productos'}`}
    title={category.name}
    text={category.description}
    crumbs={[{ label: 'Categorías', href: '/categorias' }, { label: category.name }]}
    accent={category.accent}
  >
    <div class="others">
      {
        others.map((c) => (
          <a href={`/categorias/${c.slug}`} class="chip">
            <Icon name={c.icon} size={16} /> {c.name}
          </a>
        ))
      }
    </div>
  </PageHero>

  <section class="section-sm">
    <div class="container">
      <CatalogGrid products={products} categories={categories} counts={counts} lockedCategory={category.slug} />
    </div>
  </section>
</BaseLayout>

<style>
  .others {
    display: flex;
    gap: 8px;
    flex-wrap: nowrap;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 22px -4px 0;
    padding: 4px 4px 6px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 16px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 16px), transparent);
  }
  .others::-webkit-scrollbar {
    display: none;
  }
  .others .chip {
    flex: none;
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .others {
      flex-wrap: wrap;
      overflow-x: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
