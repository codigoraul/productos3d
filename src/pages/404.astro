---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="section">
    <div class="container nf">
      <Icon name="box" size={64} stroke={1.3} />
      <h1>404</h1>
      <p>Esta página no existe o se movió. Prueba con el catálogo o el buscador.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary">Ir al inicio</a>
        <a href="/productos" class="btn btn-outline">Ver productos <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    text-align: center;
    max-width: 520px;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .nf svg {
    margin: 0 auto 12px;
    color: var(--blue);
  }
  .nf h1 {
    font-size: 5rem;
    line-height: 1;
    color: var(--blue);
  }
  .nf p {
    color: var(--muted);
    font-size: 1.1rem;
  }
  .nf-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
