---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LandingHeader from '@/components/LandingHeader.astro';
import LandingFooter from '@/components/LandingFooter.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import { SITE } from '@/config';

interface Props {
  title: string;
  description?: string;
  /** Ruta de imagen OG (absoluta o relativa al sitio). */
  image?: string;
  /** Añade el nombre del sitio al final del título (por defecto sí). */
  suffix?: boolean;
  /** Datos estructurados JSON-LD (objeto o lista de objetos). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** 'site' = header/footer del catálogo; 'landing' = menú propio con anclas, sin salida al catálogo. */
  chrome?: 'site' | 'landing';
  /** Anclas del menú cuando chrome = 'landing'. */
  landingNav?: { href: string; label: string }[];
}

const { title, description = SITE.description, image = '/og-default.png', suffix = true, jsonLd, chrome = 'site', landingNav = [] } = Astro.props;
const fullTitle = suffix ? `${title} | ${SITE.name}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0046CC" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Ir al contenido</a>
    {chrome === 'landing' ? <LandingHeader nav={landingNav} /> : <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome === 'landing' ? <LandingFooter nav={landingNav} /> : <Footer />}
    <WhatsAppFloat />

    <script>
      // Animaciones de entrada (.reveal)
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    background: var(--ink);
    color: #fff;
    padding: 10px 16px;
    border-radius: 8px;
    z-index: 1000;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 12px;
  }
</style>
